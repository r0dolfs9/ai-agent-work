{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agri-rules/cell-record.schema.json",
  "title": "Agri-rules canonical records (draft v0.1, 2026-10-14)",
  "$defs": {
    "SourceSnapshot": {
      "type": "object",
      "required": ["snapshot_id", "url", "access_method", "retrieved_at", "publisher", "title", "jurisdiction", "language", "is_official_text", "is_consolidated", "licence_note", "stored_path"],
      "properties": {
        "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the raw bytes"},
        "url": {"type": "string", "format": "uri"},
        "access_method": {"enum": ["official_structured_api", "official_bulk_dataset", "official_html", "official_pdf", "official_search_interface", "manual_download", "unofficial_connector"]},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "http_status": {"type": "integer"},
        "publisher": {"type": "string"},
        "title": {"type": "string"},
        "jurisdiction": {"type": "string", "description": "EU or ISO 3166-1 alpha-2, plus optional region code e.g. ES-CT"},
        "language": {"type": "string"},
        "is_official_text": {"type": "boolean", "description": "true only if the publication itself has legal force (e.g. OJ, Riigi Teataja consolidated)"},
        "is_consolidated": {"type": "boolean"},
        "consolidation_date": {"type": ["string", "null"], "format": "date"},
        "licence_note": {"type": "string"},
        "stored_path": {"type": "string"}
      }
    },
    "Provision": {
      "type": "object",
      "required": ["provision_id", "snapshot_id", "locator", "exact_excerpt"],
      "properties": {
        "provision_id": {"type": "string"},
        "snapshot_id": {"type": "string"},
        "locator": {"type": "string", "description": "e.g. 'Art 68(1)', '§ 3 Satz 2'"},
        "exact_excerpt": {"type": "string", "description": "verbatim substring of the snapshot text"},
        "excerpt_offset": {"type": ["integer", "null"]},
        "in_force_from": {"type": ["string", "null"], "format": "date"},
        "in_force_to": {"type": ["string", "null"], "format": "date"},
        "amended_by": {"type": "array", "items": {"type": "string"}}
      }
    },
    "CellAnswer": {
      "type": "object",
      "required": ["cell_id", "rule_id", "jurisdiction", "territorial_level", "scope", "answer_type", "value", "source_type", "provision_ids", "confidence", "verification_state", "produced_by"],
      "properties": {
        "cell_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}:[A-Z]{2}(-[A-Z0-9]+)?:[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "rule_id": {"type": "string"},
        "jurisdiction": {"type": "string"},
        "territorial_level": {"enum": ["EU", "national", "regional"]},
        "scope": {"type": "object", "properties": {"farm_type": {"type": "string"}, "worker_category": {"type": "string"}, "animal": {"type": "string"}, "crop": {"type": "string"}, "activity": {"type": "string"}}},
        "eu_baseline_ref": {"type": ["string", "null"]},
        "answer_type": {"type": "string"},
        "value": {"description": "number, string, boolean, or the literal 'NO_BINDING_RULE' / 'UNKNOWN'"},
        "unit": {"type": ["string", "null"]},
        "calculation_basis": {"type": ["string", "null"]},
        "definitions": {"type": "array", "items": {"type": "object", "properties": {"term": {"type": "string"}, "definition": {"type": "string"}, "provision_id": {"type": "string"}}}},
        "exceptions": {"type": "array", "items": {"type": "object", "properties": {"text": {"type": "string"}, "material": {"type": "boolean"}, "provision_id": {"type": "string"}}}},
        "derogations": {"type": "array", "items": {"type": "object"}},
        "regional_variations": {"type": "array", "items": {"type": "object"}},
        "collective_agreement_note": {"type": ["string", "null"]},
        "effective_from": {"type": ["string", "null"], "format": "date"},
        "effective_to": {"type": ["string", "null"], "format": "date"},
        "future_change": {"type": ["string", "null"]},
        "enforcement_authority": {"type": ["string", "null"]},
        "sanction_context": {"type": ["string", "null"]},
        "source_type": {"enum": ["binding_law", "official_guidance", "collective_agreement", "regional_rule", "court_decision", "administrative_practice"]},
        "provision_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "translation": {"type": "object", "properties": {"text": {"type": "string"}, "method": {"enum": ["human", "llm", "deepl", "llm+human"]}, "model_id": {"type": ["string", "null"]}}},
        "plain_language": {"type": ["string", "null"]},
        "practical_example": {"type": ["object", "null"], "properties": {"label": {"const": "INTERPRETATION"}, "text": {"type": "string"}}},
        "confidence": {"enum": ["H", "M", "L"]},
        "verification_state": {"enum": ["extracted", "machine-checked", "challenged", "human-reviewed", "expert-reviewed", "released", "stale"]},
        "open_issues": {"type": "array", "items": {"type": "string"}},
        "produced_by": {"type": "object", "required": ["pipeline_version", "run_id"], "properties": {"pipeline_version": {"type": "string"}, "model_id": {"type": ["string", "null"]}, "provider": {"type": ["string", "null"]}, "prompt_hash": {"type": ["string", "null"]}, "run_id": {"type": "string"}}},
        "supersedes": {"type": ["string", "null"]},
        "superseded_by": {"type": ["string", "null"]}
      }
    },
    "Review": {
      "type": "object",
      "required": ["review_id", "cell_id", "reviewer", "reviewer_role", "date", "decision"],
      "properties": {
        "review_id": {"type": "string"},
        "cell_id": {"type": "string"},
        "reviewer": {"type": "string"},
        "reviewer_role": {"enum": ["researcher", "subject_expert", "lawyer"]},
        "date": {"type": "string", "format": "date"},
        "decision": {"enum": ["accept", "correct", "reject", "escalate"]},
        "findings": {"type": "array", "items": {"type": "string"}},
        "critical_flags": {"type": "array", "items": {"enum": ["wrong_jurisdiction", "outdated_law", "missing_material_exception", "false_citation", "reversed_obligation", "wrong_threshold", "unjustified_certainty"]}}
      }
    }
  }
}
