PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
SELECT ?celex ?tdate WHERE {
  VALUES ?celex { "32024L1785"^^<http://www.w3.org/2001/XMLSchema#string> "32019L0633"^^<http://www.w3.org/2001/XMLSchema#string> "32015L0412"^^<http://www.w3.org/2001/XMLSchema#string> "32019L1152"^^<http://www.w3.org/2001/XMLSchema#string> "32014L0036"^^<http://www.w3.org/2001/XMLSchema#string> }
  ?work cdm:resource_legal_id_celex ?celex .
  OPTIONAL { ?work cdm:directive_date_transposition ?tdate }
}
