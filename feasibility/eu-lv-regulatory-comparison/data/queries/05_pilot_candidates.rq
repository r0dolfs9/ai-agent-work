PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
SELECT ?celex (SAMPLE(?f) AS ?inforce) (SAMPLE(?t) AS ?title) (COUNT(DISTINCT ?m) AS ?lv_nim) WHERE {
  VALUES ?celex { "32003L0088"^^<http://www.w3.org/2001/XMLSchema#string> "32019L1152"^^<http://www.w3.org/2001/XMLSchema#string> "31989L0391"^^<http://www.w3.org/2001/XMLSchema#string> "32009L0104"^^<http://www.w3.org/2001/XMLSchema#string> "32014L0036"^^<http://www.w3.org/2001/XMLSchema#string> "32021R2115"^^<http://www.w3.org/2001/XMLSchema#string> "32021R2116"^^<http://www.w3.org/2001/XMLSchema#string> "32013R1308"^^<http://www.w3.org/2001/XMLSchema#string> "32021R2117"^^<http://www.w3.org/2001/XMLSchema#string> "32022R1172"^^<http://www.w3.org/2001/XMLSchema#string> "32022R1173"^^<http://www.w3.org/2001/XMLSchema#string> "31991L0676"^^<http://www.w3.org/2001/XMLSchema#string> "32016L2284"^^<http://www.w3.org/2001/XMLSchema#string> "32000L0060"^^<http://www.w3.org/2001/XMLSchema#string> "32010L0075"^^<http://www.w3.org/2001/XMLSchema#string> "32024L1785"^^<http://www.w3.org/2001/XMLSchema#string> "31992L0043"^^<http://www.w3.org/2001/XMLSchema#string> "32009L0147"^^<http://www.w3.org/2001/XMLSchema#string> "32023R1115"^^<http://www.w3.org/2001/XMLSchema#string> "32009R1107"^^<http://www.w3.org/2001/XMLSchema#string> "32009L0128"^^<http://www.w3.org/2001/XMLSchema#string> "32005R0396"^^<http://www.w3.org/2001/XMLSchema#string> "32016R2031"^^<http://www.w3.org/2001/XMLSchema#string> "32019R1009"^^<http://www.w3.org/2001/XMLSchema#string> "32002L0053"^^<http://www.w3.org/2001/XMLSchema#string> "32002L0055"^^<http://www.w3.org/2001/XMLSchema#string> "31966L0401"^^<http://www.w3.org/2001/XMLSchema#string> "31966L0402"^^<http://www.w3.org/2001/XMLSchema#string> "32002L0057"^^<http://www.w3.org/2001/XMLSchema#string> "32001L0018"^^<http://www.w3.org/2001/XMLSchema#string> "32015L0412"^^<http://www.w3.org/2001/XMLSchema#string> "32016R0429"^^<http://www.w3.org/2001/XMLSchema#string> "31998L0058"^^<http://www.w3.org/2001/XMLSchema#string> "32008L0119"^^<http://www.w3.org/2001/XMLSchema#string> "32008L0120"^^<http://www.w3.org/2001/XMLSchema#string> "31999L0074"^^<http://