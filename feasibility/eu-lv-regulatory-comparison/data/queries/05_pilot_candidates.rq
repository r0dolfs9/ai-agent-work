  ?work cdm:resource_legal_id_celex ?celex .
  OPTIONAL { ?work cdm:resource_legal_in-force ?f }
  OPTIONAL { ?e cdm:expression_belongs_to_work ?work ; cdm:expression_uses_language <http://publications.europa.eu/resource/authority/language/ENG> ; cdm:expression_title ?t }
  OPTIONAL { { ?m cdm:measure_national_implementing_implements_resource_legal ?work } UNION { ?m cdm:measure_national_implementing_implements_directive ?work }
